# FinPass AI — environment template.
# Copy to `.env` and fill real values for local dev.
# In production these live as SECRETS in the Hugging Face Space
# (Settings -> Variables and secrets), NOT in Vercel.

# --- Database (MongoDB Atlas) -------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=mockDB
COLLECTION_NAME=userGoals

# --- Auth / JWT ---------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (Groq) ---------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# --- RAG / Embeddings ---------------------------------------------------------
VECTOR_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=finpass_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_API_TOKEN=your_hf_api_token

# --- GitHub OAuth -------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
FRONTEND_BASE_URL=https://ai-driven-invest-planner.vercel.app
# Public URL of THIS backend (where OAuth providers send the code).
BACKEND_BASE_URL=https://umairlari-ai-financial-advisor-backend.hf.space

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- Transactional email (Resend) ---------------------------------------------
RESEND_API_KEY=your_resend_api_key
APP_URL=https://ai-driven-invest-planner.vercel.app

# --- Runtime ------------------------------------------------------------------
# For local dev the app listens on 5000 (frontend config.js DEV_URL); HF uses 7860.
PORT=5000
FLASK_ENV=development
LOG_LEVEL=INFO
